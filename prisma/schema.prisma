generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String            @id @default(uuid())
  lpuId                    String            @unique
  name                     String
  email                    String            @unique
  phone                    String?
  passwordHash             String
  role                     UserRole
  status                   UserStatus        @default(ACTIVE)
  assignedStationId        String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  auditLogs                AuditLog[]        @relation("ActorAuditLogs")
  damageReportsFiled       DamageReport[]    @relation("StaffDamageReports")
  notifications            Notification[]
  rebalancingTasksAssigned RebalancingTask[] @relation("StaffRebalancingTasks")
  refreshTokens            RefreshToken[]
  rentals                  Rental[]          @relation("StudentRentals")
  returnTokensIssued       ReturnToken[]     @relation("StaffReturnTokens")
  assignedStation          Station?          @relation("StationStaff", fields: [assignedStationId], references: [id])

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Station {
  id                String            @id @default(uuid())
  code              String            @unique
  name              String
  description       String?
  latitude          Float
  longitude         Float
  capacity          Int
  status            StationStatus     @default(ACTIVE)
  openingTime       String
  closingTime       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  rebalancingFrom   RebalancingTask[] @relation("RebalanceFromStation")
  rebalancingTo     RebalancingTask[] @relation("RebalanceToStation")
  rentalsOriginated Rental[]          @relation("OriginStation")
  rentalsReturned   Rental[]          @relation("ReturnStation")
  returnTokens      ReturnToken[]
  umbrellas         Umbrella[]
  assignedStaff     User[]            @relation("StationStaff")

  @@index([status])
}

model Umbrella {
  id               String            @id @default(uuid())
  publicCode       String            @unique
  qrIdentifier     String            @unique
  status           UmbrellaStatus    @default(AVAILABLE)
  condition        UmbrellaCondition @default(GOOD)
  currentStationId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  damageReports    DamageReport[]
  rentals          Rental[]
  currentStation   Station?          @relation(fields: [currentStationId], references: [id])

  @@index([status])
  @@index([currentStationId])
}

model PricingPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  durationMinutes Int
  pricePaise      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rentals         Rental[]
}

model Rental {
  id                      String        @id @default(uuid())
  studentId               String
  umbrellaId              String
  pricingPlanId           String
  priceAtRentalPaise      Int
  durationMinutesAtRental Int
  status                  RentalStatus  @default(CREATED)
  originStationId         String
  returnStationId         String?
  startedAt               DateTime?
  dueAt                   DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  payment                 Payment?
  originStation           Station       @relation("OriginStation", fields: [originStationId], references: [id])
  pricingPlan             PricingPlan   @relation(fields: [pricingPlanId], references: [id])
  returnStation           Station?      @relation("ReturnStation", fields: [returnStationId], references: [id])
  student                 User          @relation("StudentRentals", fields: [studentId], references: [id])
  umbrella                Umbrella      @relation(fields: [umbrellaId], references: [id])
  returnTokens            ReturnToken[]

  @@index([studentId])
  @@index([umbrellaId])
  @@index([status])
}

model Payment {
  id                String        @id @default(uuid())
  rentalId          String        @unique
  provider          String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  createdAt         DateTime      @default(now())
  verifiedAt        DateTime?
  updatedAt         DateTime      @updatedAt
  rental            Rental        @relation(fields: [rentalId], references: [id])

  @@index([status])
}

model ReturnToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  rentalId  String
  studentId String
  staffId   String
  stationId String
  used      Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  rental    Rental    @relation(fields: [rentalId], references: [id])
  staff     User      @relation("StaffReturnTokens", fields: [staffId], references: [id])
  station   Station   @relation(fields: [stationId], references: [id])

  @@index([rentalId])
  @@index([expiresAt])
}

model DamageReport {
  id           String             @id @default(uuid())
  umbrellaId   String
  reportedById String
  severity     DamageSeverity
  description  String
  status       DamageReportStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  reportedBy   User               @relation("StaffDamageReports", fields: [reportedById], references: [id])
  umbrella     Umbrella           @relation(fields: [umbrellaId], references: [id])

  @@index([umbrellaId])
  @@index([status])
}

model RebalancingTask {
  id              String                @id @default(uuid())
  fromStationId   String
  toStationId     String
  umbrellaCount   Int
  status          RebalancingTaskStatus @default(PENDING)
  assignedStaffId String?
  notes           String?
  createdAt       DateTime              @default(now())
  completedAt     DateTime?
  assignedStaff   User?                 @relation("StaffRebalancingTasks", fields: [assignedStaffId], references: [id])
  fromStation     Station               @relation("RebalanceFromStation", fields: [fromStationId], references: [id])
  toStation       Station               @relation("RebalanceToStation", fields: [toStationId], references: [id])

  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())
  actor     User?       @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum StationStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UmbrellaStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  MISSING
  LOST
  RETIRED
}

enum UmbrellaCondition {
  GOOD
  FAIR
  DAMAGED
}

enum RentalStatus {
  CREATED
  PAYMENT_PENDING
  ACTIVE
  OVERDUE
  RETURN_PENDING
  COMPLETED
  CANCELLED
  LOST
}

enum PaymentStatus {
  CREATED
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum DamageSeverity {
  MINOR
  MAJOR
  UNUSABLE
}

enum DamageReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum RebalancingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  RENTAL_ACTIVATED
  RENTAL_OVERDUE
  RETURN_COMPLETED
  PAYMENT_VERIFIED
  PAYMENT_FAILED
  GENERAL
}

enum AuditAction {
  LOGIN
  REGISTER
  RENTAL_CREATED
  PAYMENT_CREATED
  PAYMENT_VERIFIED
  PAYMENT_FAILED
  RENTAL_ACTIVATED
  RETURN_TOKEN_CREATED
  RETURN_COMPLETED
  RENTAL_MARKED_OVERDUE
  RENTAL_CANCELLED
  UMBRELLA_MARKED_MAINTENANCE
  UMBRELLA_MARKED_MISSING
  UMBRELLA_MARKED_LOST
  UMBRELLA_MARKED_AVAILABLE
  INVENTORY_MOVED
  ADMIN_ACTION
}
