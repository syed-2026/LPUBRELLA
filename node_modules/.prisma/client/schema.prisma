// ==========================================
// LPU Umbrella - Prisma Schema
// PostgreSQL + UUID primary keys
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum StationStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UmbrellaStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  MISSING
  LOST
  RETIRED
}

enum UmbrellaCondition {
  GOOD
  FAIR
  DAMAGED
}

enum RentalStatus {
  CREATED
  PAYMENT_PENDING
  ACTIVE
  OVERDUE
  RETURN_PENDING
  COMPLETED
  CANCELLED
  LOST
}

enum PaymentStatus {
  CREATED
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum DamageSeverity {
  MINOR
  MAJOR
  UNUSABLE
}

enum DamageReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum RebalancingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  RENTAL_ACTIVATED
  RENTAL_OVERDUE
  RETURN_COMPLETED
  PAYMENT_VERIFIED
  PAYMENT_FAILED
  GENERAL
}

enum AuditAction {
  LOGIN
  REGISTER
  RENTAL_CREATED
  PAYMENT_CREATED
  PAYMENT_VERIFIED
  PAYMENT_FAILED
  RENTAL_ACTIVATED
  RETURN_TOKEN_CREATED
  RETURN_COMPLETED
  RENTAL_MARKED_OVERDUE
  RENTAL_CANCELLED
  UMBRELLA_MARKED_MAINTENANCE
  UMBRELLA_MARKED_MISSING
  UMBRELLA_MARKED_LOST
  UMBRELLA_MARKED_AVAILABLE
  INVENTORY_MOVED
  ADMIN_ACTION
}

// ------------------------------------------
// MODELS
// ------------------------------------------

model User {
  id           String     @id @default(uuid())
  lpuId        String     @unique
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  // Staff-only: the station a staff member is assigned to.
  // Nullable because students/admins have no station assignment.
  assignedStationId String?
  assignedStation   Station? @relation("StationStaff", fields: [assignedStationId], references: [id])

  rentals                  Rental[]          @relation("StudentRentals")
  returnTokensIssued       ReturnToken[]     @relation("StaffReturnTokens")
  damageReportsFiled       DamageReport[]    @relation("StaffDamageReports")
  rebalancingTasksAssigned RebalancingTask[] @relation("StaffRebalancingTasks")
  notifications            Notification[]
  auditLogs                AuditLog[]        @relation("ActorAuditLogs")
  refreshTokens            RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

// Persisted refresh tokens so they can be revoked on logout.
// Store only a hash of the raw token, never the raw token itself.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Station {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  latitude    Float
  longitude   Float
  capacity    Int
  status      StationStatus @default(ACTIVE)
  openingTime String // e.g. "07:00" (24h HH:mm, local campus time)
  closingTime String // e.g. "21:00"

  umbrellas         Umbrella[]
  assignedStaff     User[]            @relation("StationStaff")
  returnTokens      ReturnToken[]
  rentalsOriginated Rental[]          @relation("OriginStation")
  rentalsReturned   Rental[]          @relation("ReturnStation")
  rebalancingFrom   RebalancingTask[] @relation("RebalanceFromStation")
  rebalancingTo     RebalancingTask[] @relation("RebalanceToStation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Umbrella {
  id               String            @id @default(uuid())
  publicCode       String            @unique // human-readable, e.g. "UMB-0001"
  qrIdentifier     String            @unique // value encoded in the physical QR
  status           UmbrellaStatus    @default(AVAILABLE)
  condition        UmbrellaCondition @default(GOOD)
  currentStationId String?
  currentStation   Station?          @relation(fields: [currentStationId], references: [id])

  rentals       Rental[]
  damageReports DamageReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentStationId])
}

model PricingPlan {
  id              String  @id @default(uuid())
  name            String  @unique // "Quick", "Campus", "Day", "Home"
  durationMinutes Int
  pricePaise      Int // integer paise, never floating point
  active          Boolean @default(true)

  rentals Rental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rental {
  id        String @id @default(uuid())
  studentId String
  student   User   @relation("StudentRentals", fields: [studentId], references: [id])

  umbrellaId String
  umbrella   Umbrella @relation(fields: [umbrellaId], references: [id])

  pricingPlanId String
  pricingPlan   PricingPlan @relation(fields: [pricingPlanId], references: [id])

  // Snapshot of pricing at time of rental creation, so later pricing
  // changes never retroactively alter historical rentals.
  priceAtRentalPaise      Int
  durationMinutesAtRental Int

  status RentalStatus @default(CREATED)

  originStationId String
  originStation   Station @relation("OriginStation", fields: [originStationId], references: [id])

  returnStationId String?
  returnStation   Station? @relation("ReturnStation", fields: [returnStationId], references: [id])

  startedAt   DateTime? // set when rental becomes ACTIVE
  dueAt       DateTime? // startedAt + durationMinutesAtRental, set on activation
  completedAt DateTime?
  cancelledAt DateTime?

  payment      Payment?
  returnTokens ReturnToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([umbrellaId])
  @@index([status])
}

model Payment {
  id                String        @id @default(uuid())
  rentalId          String        @unique
  rental            Rental        @relation(fields: [rentalId], references: [id])
  provider          String // e.g. "razorpay"
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  failureReason     String?

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

// Temporary, single-use, short-lived tokens for the staff-assisted
// return flow. Only a hash of the raw token is stored.
model ReturnToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  rentalId  String
  rental    Rental    @relation(fields: [rentalId], references: [id])
  studentId String // denormalized for fast validation
  staffId   String
  staff     User      @relation("StaffReturnTokens", fields: [staffId], references: [id])
  stationId String
  station   Station   @relation(fields: [stationId], references: [id])
  used      Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([rentalId])
  @@index([expiresAt])
}

model DamageReport {
  id           String             @id @default(uuid())
  umbrellaId   String
  umbrella     Umbrella           @relation(fields: [umbrellaId], references: [id])
  reportedById String
  reportedBy   User               @relation("StaffDamageReports", fields: [reportedById], references: [id])
  severity     DamageSeverity
  description  String
  status       DamageReportStatus @default(OPEN)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([umbrellaId])
  @@index([status])
}

// Admin-reviewed tasks for moving umbrellas between stations to
// balance supply. Not automated in the MVP; created/reviewed by admin.
model RebalancingTask {
  id              String                @id @default(uuid())
  fromStationId   String
  fromStation     Station               @relation("RebalanceFromStation", fields: [fromStationId], references: [id])
  toStationId     String
  toStation       Station               @relation("RebalanceToStation", fields: [toStationId], references: [id])
  umbrellaCount   Int
  status          RebalancingTaskStatus @default(PENDING)
  assignedStaffId String?
  assignedStaff   User?                 @relation("StaffRebalancingTasks", fields: [assignedStaffId], references: [id])
  notes           String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  title   String
  message String
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  actor     User?       @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
}
