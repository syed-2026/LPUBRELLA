# ==========================================
# LPU Umbrella Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==========================================

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lpu_umbrella?schema=public"

# JWT
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_chars"
JWT_REFRESH_SECRET="replace_with_a_different_long_random_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateway (Razorpay-compatible, UPI support)
PAYMENT_PROVIDER="razorpay"
PAYMENT_KEY="rzp_test_TTYc8wceFDDXMk"
PAYMENT_SECRET="slkKz2KgQt26xgE55QqrhnMY"
PAYMENT_WEBHOOK_SECRET="LPU_Umbrella_RazorPay_Webhook_2026!X7mQ9#vT4Kp2@N2004"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Return QR
RETURN_TOKEN_TTL_SECONDS=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
QR_RATE_LIMIT_MAX=20
PAYMENT_RATE_LIMIT_MAX=15
